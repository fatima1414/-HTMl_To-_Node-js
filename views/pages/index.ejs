<%- include('../layout/headSection') %>
<%- include('../layout/header') %>

<div class="container my-5">
  <h1 class="text-center fw-bold mb-4">Welcome to Our Website</h1>

  <div class="row g-4">
    <% services.slice(0,3).forEach(s => { %>
      <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
          <img src="<%= s.profile %>" class="card-img-top" style="height:230px; object-fit:cover;">
          <div class="card-body text-center">
            <h5 class="fw-bold"><%= s.title %></h5>
            <p class="text-muted"><%= s.content %></p>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<%- include('../layout/Footer') %>
